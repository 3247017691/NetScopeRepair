<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NetScope.Cli</RootNamespace>
    <AssemblyName>netscope</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetScope.Application\NetScope.Application.csproj" />
    <ProjectReference Include="..\NetScope.Collectors.Windows\NetScope.Collectors.Windows.csproj" />
    <ProjectReference Include="..\NetScope.Diagnostics\NetScope.Diagnostics.csproj" />
    <ProjectReference Include="..\NetScope.Domain\NetScope.Domain.csproj" />
    <ProjectReference Include="..\NetScope.Probes\NetScope.Probes.csproj" />
    <ProjectReference Include="..\NetScope.Storage\NetScope.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\contracts\event-envelope.schema.json"
          Link="contracts\event-envelope.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fixtures\synthetic\synthetic-incident.ndjson"
          Link="fixtures\synthetic-incident.ndjson"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
