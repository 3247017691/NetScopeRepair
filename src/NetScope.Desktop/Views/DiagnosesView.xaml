<UserControl x:Class="NetScope.Desktop.Views.DiagnosesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080">
    <StackPanel>
        <!-- Top Summary Card -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="结论与证据" Style="{StaticResource H2}" />
                <TextBlock Text="每条结论都引用实际观测的 evidence_id，并单列反证与缺失证据；规则执行失败不会伪造结论。"
                           Style="{StaticResource Caption}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                <TextBlock Text="{Binding ObservationText}" Style="{StaticResource Caption}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                <!-- Synthetic Warning Alert -->
                <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1" CornerRadius="6"
                        Padding="12,8" Margin="0,10,0,0" HorizontalAlignment="Left"
                        Visibility="{Binding IsSynthetic, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01"
                              Stroke="{StaticResource Warn}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding DataLabel}" Foreground="{StaticResource Warn}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <!-- Empty Text -->
                <TextBlock Text="{Binding EmptyText}" HorizontalAlignment="Left" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRows}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Master-Detail 2-Column Section -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Diagnosis List (Master) -->
            <Border Grid.Column="0" Style="{StaticResource SectionCard}" Padding="10" VerticalAlignment="Top">
                <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VerticalAlignment="Top"
                         MaxHeight="480">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Chrome" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="8" Padding="13,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="ActiveBar" Grid.Column="0" Background="Transparent" CornerRadius="2" Margin="0,2,0,2" />
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <DockPanel LastChildFill="False">
                                                        <Border DockPanel.Dock="Left" Background="{Binding BadgeBackground}" BorderThickness="0"
                                                                CornerRadius="11" Padding="8,2.5" Margin="0,0,8,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="5.5" Height="5.5" Fill="{Binding Tone}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                                <TextBlock Text="{Binding LevelText}" Foreground="{Binding Tone}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding RuleId}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding RuleVersion, StringFormat=v{0}}" Margin="6,0,0,0"
                                                                   Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12.5" Margin="0,6,0,0" Foreground="{StaticResource Ink}" LineHeight="18" />
                                                    <TextBlock Text="{Binding ScopeText}" Style="{StaticResource Caption}" Margin="0,5,0,0" FontSize="11" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SubtleSurface}" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HoverBorder}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentLight}" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                                <Setter TargetName="ActiveBar" Property="Background" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- Right: Diagnosis Details (Detail) -->
            <StackPanel Grid.Column="2">
                <!-- Diagnosis Info Card -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <!-- Header Line -->
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{Binding Selected.BadgeBackground}" BorderThickness="0"
                                        CornerRadius="11" Padding="9,3" Margin="0,0,9,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{Binding Selected.Tone}" VerticalAlignment="Center" Margin="0,0,5.5,0" />
                                        <TextBlock Text="{Binding Selected.LevelText}" Foreground="{Binding Selected.Tone}" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding Selected.RuleId}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Selected.RuleVersion, StringFormat=v{0}}"
                                           Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource BadBg}" BorderThickness="0"
                                    CornerRadius="11" Padding="9,3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Bad}" VerticalAlignment="Center" Margin="0,0,5.5,0" />
                                    <TextBlock Text="不执行修复" FontSize="11.5" Foreground="{StaticResource Bad}" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <!-- Summary -->
                        <TextBlock Text="{Binding Selected.Summary}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Ink}"
                                   Margin="0,12,0,0" LineHeight="20" />

                        <!-- Scope & Suggested Next Step Box -->
                        <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                CornerRadius="6" Padding="14,10" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.ScopeText, StringFormat=适用范围：{0}}"
                                           FontSize="12" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                                <Border Height="1" Background="{StaticResource LineSubtle}" Margin="0,8" />
                                <TextBlock Text="{Binding Selected.NextStep, StringFormat=建议下一步：{0}}"
                                           FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                <Button Content="去修复" Command="{Binding GoRepairCommand}"
                                        Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Evidence References Grid -->
                        <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                CornerRadius="6" Padding="14,10" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="引用证据 ID" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,2" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.EvidenceText}" Style="{StaticResource Mono}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="反证证据" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.CounterText}" Style="{StaticResource Mono}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="缺失证据" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,2" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.MissingText}" Style="{StaticResource Mono}" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource Warn}" Margin="0,2" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 三路径对比 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding ProbeComparisonTitle}" Style="{StaticResource H2}"
                                       VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Right" Background="{StaticResource GapBg}" BorderThickness="0"
                                    CornerRadius="11" Padding="9,3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{Binding ComparisonTone}" VerticalAlignment="Center"
                                             Margin="0,0,5.5,0" />
                                    <TextBlock Text="{Binding ComparisonVerdictText}" Foreground="{Binding ComparisonTone}"
                                               FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <TextBlock Text="{Binding ComparisonDetailText}" FontSize="12" Foreground="{StaticResource Ink}"
                                   TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding GroupNoteText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <TextBlock Text="{Binding ProbeEmptyText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasNoProbeComparison, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl ItemsSource="{Binding PathRows}" Margin="0,10,0,0"
                                      Visibility="{Binding HasProbeComparison, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}"
                                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <Border DockPanel.Dock="Left" Background="{Binding BadgeBackground}"
                                                        BorderThickness="0" CornerRadius="11" Padding="8,2.5" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="5.5" Height="5.5" Fill="{Binding Tone}" VerticalAlignment="Center"
                                                                 Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding Tone}" FontSize="11"
                                                                   FontWeight="Medium" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding PathText}" FontWeight="SemiBold"
                                                           FontSize="12.5" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding ClassificationText}"
                                                           Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Grid Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding StageText, StringFormat=阶段：{0}}"
                                                           FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding FailureText, StringFormat=结果：{0}}"
                                                           FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                            </Grid>
                                            <TextBlock Text="{Binding FamilyText}" FontSize="11.5" Foreground="{StaticResource Muted}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding ConnectionText}" FontSize="11.5" Foreground="{StaticResource Muted}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding ResolutionText}" FontSize="11.5" Foreground="{StaticResource Muted}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding TimingText}" FontSize="11.5" Foreground="{StaticResource Muted}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding NoticeText}" Style="{StaticResource MonoSubtle}" FontSize="10.5"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 地址族能力 -->
                        <StackPanel Visibility="{Binding HasProbeComparison, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding FamilyCapabilityTitle}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding FamilyCapabilityCaption}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,3,0,6" />
                            <ItemsControl ItemsSource="{Binding FamilyRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding BadgeBackground}" BorderThickness="0" CornerRadius="6"
                                                Padding="10,7" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding PathText}" FontSize="11.5"
                                                           Foreground="{StaticResource Ink}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding RequestedText}" FontSize="11"
                                                           Foreground="{Binding Tone}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding CapabilityText}" FontSize="11.5"
                                                           Foreground="{StaticResource Ink}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                            <TextBlock Text="{Binding ProbeBoundaryText}" FontSize="11.5" Foreground="{StaticResource Warn}"
                                       TextWrapping="Wrap" LineHeight="18" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 部分 / 未支持原因（可展开） -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding ReasonHeaderText}" Style="{StaticResource H2}"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="{Binding ReasonsToggleText}"
                                    Command="{Binding ToggleReasonsCommand}" Style="{StaticResource QuietButton}"
                                    Visibility="{Binding HasReasons, Converter={StaticResource BoolToVis}}"
                                    VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding ReasonsCaption}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   HorizontalAlignment="Left" Margin="0,4,0,8" />
                        <TextBlock Text="{Binding ReasonsEmptyText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   HorizontalAlignment="Left"
                                   Visibility="{Binding ShowReasonsEmpty, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Reasons}"
                                      Visibility="{Binding ReasonsVisible, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}"
                                            BorderThickness="1" CornerRadius="6" Padding="11,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <Border DockPanel.Dock="Left" Background="{Binding BadgeBackground}"
                                                        BorderThickness="0" CornerRadius="11" Padding="8,2"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding Tone}"
                                                               FontSize="10.5" FontWeight="Medium" />
                                                </Border>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding SourceText}"
                                                           FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}"
                                                           Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{StaticResource Ink}"
                                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="被测证据" Style="{StaticResource H2}" />
                        <TextBlock Text="按 evidence_id 展开；缺失引用会明确标出，而不是静默跳过。" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Left" Margin="0,4,0,12" />
                        <ItemsControl ItemsSource="{Binding SelectedEvidence}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <Border DockPanel.Dock="Left" Background="{StaticResource AccentLight}" BorderBrush="{StaticResource AccentBorder}"
                                                        BorderThickness="1" CornerRadius="4" Padding="6,1.5">
                                                    <TextBlock Text="{Binding EvidenceId}" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Accent}" FontWeight="Medium" />
                                                </Border>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Kind}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12.5" FontWeight="Medium" Margin="0,6,0,0" Foreground="{StaticResource Ink}" />
                                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                    CornerRadius="4" Padding="8,6" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Facts}" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 规则执行失败 Card -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="规则执行失败" Style="{StaticResource H2}" />
                        <TextBlock Text="这些规则本轮没有结论；它们不会被写成“正常”，也不会编造证据引用。"
                                   Style="{StaticResource Caption}" HorizontalAlignment="Left" Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding Failures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="8,5" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding RuleId}" FontSize="12"
                                                   Foreground="{StaticResource Warn}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12"
                   Margin="2,0,0,6" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
