<UserControl x:Class="NetScope.Desktop.Views.DiagnosesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080">
    <StackPanel>
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="结论与证据" Style="{StaticResource H2}" />
                <TextBlock Text="每条结论都引用实际观测的 evidence_id，并单列反证与缺失证据；规则执行失败不会伪造结论。"
                           Style="{StaticResource Caption}" Margin="0,4,0,0" MaxWidth="820" />
                <TextBlock Text="{Binding ObservationText}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                <Border Background="#FFF4E0" BorderBrush="#EED9A8" BorderThickness="1" CornerRadius="6"
                        Padding="10,6" Margin="0,10,0,0"
                        Visibility="{Binding IsSynthetic, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding DataLabel}" Foreground="{StaticResource Warn}" FontSize="12" />
                </Border>
                <TextBlock Text="{Binding EmptyText}" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRows}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SectionCard}" Padding="10">
                <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MaxHeight="440">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Chrome" Background="#FAFBFD" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="8" Padding="13,11">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="#F1F5FD" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="#EAF0FE" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{Binding Tone}" CornerRadius="999" Padding="8,2" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding LevelText}" Foreground="White" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="{Binding RuleId}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding RuleVersion, StringFormat=v{0}}" Margin="6,1,0,0"
                                               Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12.5" Margin="0,7,0,0" />
                                <TextBlock Text="{Binding ScopeText}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{Binding Selected.Tone}" CornerRadius="999" Padding="9,3" Margin="0,0,9,0">
                                <TextBlock Text="{Binding Selected.LevelText}" Foreground="White" FontSize="11" />
                            </Border>
                            <TextBlock Text="{Binding Selected.RuleId}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding Selected.RuleVersion, StringFormat=v{0}}"
                                       Style="{StaticResource Caption}" Margin="8,2,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Selected.Summary}" TextWrapping="Wrap" FontSize="13" Margin="0,12,0,0" />
                        <Border Background="#F7F9FC" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.ScopeText, StringFormat=适用范围：{0}}"
                                           Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Selected.NextStep, StringFormat=建议下一步：{0}}"
                                           Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{Binding Selected.EvidenceText, StringFormat=证据：{0}}"
                                       FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Selected.MissingText, StringFormat=缺失：{0}}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,6,0,8" />
                            <Border Style="{StaticResource Pill}" Background="#FBEAE8" HorizontalAlignment="Left">
                                <TextBlock Text="M1 不执行修复" FontSize="11" Foreground="{StaticResource Bad}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="被测证据" Style="{StaticResource H2}" />
                        <TextBlock Text="按 evidence_id 展开；缺失引用会明确标出，而不是静默跳过。" Style="{StaticResource Caption}"
                                   Margin="0,4,0,10" />
                        <ItemsControl ItemsSource="{Binding SelectedEvidence}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAFBFD" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                            CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding EvidenceId}" Style="{StaticResource Mono}"
                                                           FontSize="11.5" Foreground="{StaticResource Accent}" />
                                                <TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}"
                                                           Margin="10,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12"
                                                       Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Facts}" Style="{StaticResource Caption}"
                                                       FontSize="11" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="规则执行失败" Style="{StaticResource H2}" />
                        <TextBlock Text="这些规则本轮没有结论；它们不会被写成“正常”，也不会编造证据引用。"
                                   Style="{StaticResource Caption}" Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding Failures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RuleId, StringFormat=· {0}}" FontSize="12"
                                               Foreground="{StaticResource Warn}" Margin="0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12"
                   Margin="2,0,0,6" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
