<UserControl x:Class="NetScope.Desktop.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1440"
             Background="{StaticResource Canvas}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Rail}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,20">
                    <TextBlock Text="NetScope Repair" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="只读网络诊断 · M1" Foreground="{StaticResource RailMuted}" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="22,0,22,18" Text="无修复入口 · 不修改网络"
                           Foreground="{StaticResource RailMuted}" FontSize="11" />

                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="10,2" />
                            <Setter Property="Padding" Value="14,10" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Foreground" Value="{StaticResource RailMuted}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="#1E293B" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="#22304A" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13.5" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                                <TextBlock Text="{Binding Caption}" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{StaticResource RailMuted}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1" Padding="26,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
                        <TextBlock Text="{Binding PageCaption}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource Pill}" Background="#EEF2F8" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding StateTone}" VerticalAlignment="Center"
                                         Margin="0,0,7,0" />
                                <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                        <Button Content="开始观察" Command="{Binding Home.StartCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                        <Button Content="暂停" Command="{Binding Home.PauseCommand}"
                                Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                        <Button Content="立即诊断" Command="{Binding Home.DiagnoseCommand}"
                                Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                        <Button Content="载入合成演示" Command="{Binding LoadDemoCommand}"
                                Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,22,26,30">
                <StackPanel>
                    <Border Background="#FFF4E0" BorderBrush="#EED9A8" BorderThickness="1" CornerRadius="8"
                            Padding="14,10" Margin="0,0,0,14"
                            Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding DemoBannerText}" FontSize="12" Foreground="{StaticResource Warn}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <ContentControl Content="{Binding SelectedSection.ViewModel}" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2">
                <Border Background="#F2F5FA" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                        Padding="26,7" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12"
                               TextWrapping="Wrap" />
                </Border>
                <Border Background="#FFF6E5" BorderBrush="#EED9A8" BorderThickness="0,1,0,0"
                        Padding="26,8" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Warn}" FontSize="12"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
