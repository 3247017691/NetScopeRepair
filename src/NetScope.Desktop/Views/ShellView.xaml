<UserControl x:Class="NetScope.Desktop.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1440"
             Background="{StaticResource Canvas}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="246" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Rail (Slate-50 with 1px right border) -->
        <Border Grid.Column="0" Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand Area -->
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Brand Icon: Rounded Square with White Vector Shield/Pulse -->
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7" Background="#0F172A" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path Data="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                                  Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!-- Brand Title & Badge -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="NetScope Repair" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Border Background="{StaticResource AccentLight}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="M1 只读版" FontSize="10.5" FontWeight="Medium" Foreground="{StaticResource Accent}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineSubtle}" Margin="0,16,0,0" />
                </StackPanel>

                <!-- Sidebar Bottom Safety Card -->
                <Border DockPanel.Dock="Bottom" Margin="12,10,12,16" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,9">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                              Stroke="{StaticResource Muted}" StrokeThickness="1.5" Width="12" Height="12"
                              Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="无修复入口 · 不修改网络" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Navigation ListBox -->
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="10,2" />
                            <Setter Property="Padding" Value="10,9" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="NavIcon" Grid.Column="0" Data="{Binding IconGeometry}"
                                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Fill="Transparent" Width="15" Height="15" Stretch="Uniform"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,1,0,0" />
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock x:Name="NavTitle" Text="{Binding Title}" FontSize="13" FontWeight="Normal"
                                                               Foreground="{TemplateBinding Foreground}" />
                                                    <TextBlock x:Name="NavCaption" Text="{Binding Caption}" FontSize="10.5" Margin="0,1.5,0,0"
                                                               Foreground="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverSurface}" />
                                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface}" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Line}" />
                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                <Setter TargetName="NavTitle" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="NavTitle" Property="Foreground" Value="{StaticResource Ink}" />
                                                <Setter TargetName="NavCaption" Property="Foreground" Value="{StaticResource Muted}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right Main Surface -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header Toolbar -->
            <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1" Padding="26,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
                        <TextBlock Text="{Binding PageCaption}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- Modern Status Pill -->
                        <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="999" Padding="10,5" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{Binding StateTone}" VerticalAlignment="Center"
                                         Margin="0,0,7,0" />
                                <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button Content="开始观察" Command="{Binding Home.StartCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                        <Button Content="暂停" Command="{Binding Home.PauseCommand}"
                                Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                        <Button Content="立即诊断" Command="{Binding Home.DiagnoseCommand}"
                                Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                        <Button Content="载入合成演示" Command="{Binding LoadDemoCommand}"
                                Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main Scrollable Canvas -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24,28,30">
                <StackPanel>
                    <!-- Demo Alert Banner -->
                    <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1" CornerRadius="8"
                            Padding="14,10" Margin="0,0,0,16"
                            Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01"
                                  Stroke="{StaticResource Warn}" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DemoBannerText}" FontSize="12" Foreground="{StaticResource Warn}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>
                    </Border>
                    <ContentControl Content="{Binding SelectedSection.ViewModel}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Notifications -->
            <StackPanel Grid.Row="2">
                <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                        Padding="26,8" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12"
                               TextWrapping="Wrap" />
                </Border>
                <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="0,1,0,0"
                        Padding="26,8" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Warn}" FontSize="12"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
