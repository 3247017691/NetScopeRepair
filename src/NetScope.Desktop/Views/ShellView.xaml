<UserControl x:Class="NetScope.Desktop.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1440"
             Background="{StaticResource Canvas}">
    <UserControl.Resources>
        <!-- Quiet rail item shared by the secondary and footer lists. -->
        <Style x:Key="RailNavItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="ActiveBar" Width="3" HorizontalAlignment="Left" CornerRadius="2"
                                    Background="{StaticResource Accent}" Visibility="Collapsed" Margin="0,5" />
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Margin="5,0,0,0"
                                    Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="NavIcon" Grid.Column="0" Data="{Binding IconGeometry}"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Fill="Transparent" Width="15" Height="15" Stretch="Uniform"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,1,0,0" />
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock x:Name="NavTitle" Text="{Binding Title}" FontSize="13" FontWeight="Normal"
                                                   Foreground="{TemplateBinding Foreground}" />
                                        <TextBlock x:Name="NavCaption" Text="{Binding Caption}" FontSize="10.5" Margin="0,1.5,0,0"
                                                   Foreground="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverSurface}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverSurface}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                <Setter TargetName="NavTitle" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="NavTitle" Property="Foreground" Value="{StaticResource Ink}" />
                                <Setter TargetName="NavCaption" Property="Foreground" Value="{StaticResource Muted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation rail -->
        <Border Grid.Column="0" Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="36" Height="36"
                               Source="pack://application:,,,/Resources/netscope-logo.png"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="NetScope Repair" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="网络诊断 · 受控修复" FontSize="10.5" Foreground="{StaticResource SubtleText}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineSubtle}" Margin="0,16,0,0" />
                </StackPanel>

                <!-- Primary entry: repair -->
                <Button DockPanel.Dock="Top" Margin="12,2,12,10"
                        Command="{Binding Home.OpenRepairCommand}"
                        Cursor="Hand" FocusVisualStyle="{StaticResource FocusVisual}"
                        AutomationProperties.Name="修复">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="ActiveBar" Width="3" HorizontalAlignment="Left" CornerRadius="2"
                                        Background="{StaticResource Accent}" Visibility="Collapsed" Margin="0,6" />
                                <Border x:Name="Chrome" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="5,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{Binding PrimarySection.IconGeometry}"
                                              Stroke="{StaticResource Accent}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Fill="Transparent" Width="18" Height="18" Stretch="Uniform"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PrimarySection.Title}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Ink}" />
                                            <TextBlock Text="{Binding PrimarySection.Caption}" FontSize="10.5" Margin="0,2,0,0"
                                                       Foreground="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{Binding StateTone}"
                                                 VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverSurface}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HoverBorder}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding SelectedSection.Group}" Value="Primary">
                                    <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Secondary group header -->
                <StackPanel DockPanel.Dock="Top" Margin="20,2,18,4">
                    <Border Height="1" Background="{StaticResource LineSubtle}" Margin="0,0,0,10" />
                    <TextBlock Text="观察与工具" FontSize="11" FontWeight="Medium" Foreground="{StaticResource SubtleText}" />
                </StackPanel>

                <!-- Safety note -->
                <Border DockPanel.Dock="Bottom" Margin="12,10,12,16" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,9">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                              Stroke="{StaticResource Muted}" StrokeThickness="1.5" Width="12" Height="12"
                              Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="修复需二次确认 · 全部可回滚" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Footer navigation -->
                <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding FooterSections}"
                         SelectedItem="{Binding FooterSelected, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource RailNavItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                <!-- Secondary navigation -->
                <ListBox ItemsSource="{Binding SecondarySections}"
                         SelectedItem="{Binding SecondarySelected, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource RailNavItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>

        <!-- Main surface -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1" Padding="26,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
                        <TextBlock Text="{Binding PageCaption}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="{Binding StateBg}" BorderThickness="0" CornerRadius="13" Padding="11,4.5" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6.5" Height="6.5" Fill="{Binding StateTone}" VerticalAlignment="Center" Margin="0,0,6.5,0" />
                                <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="Medium" Foreground="{Binding StateTone}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button Content="开始观察" Command="{Binding Home.StartCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                        <Button Content="暂停" Command="{Binding Home.PauseCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                        <Button Content="立即诊断" Command="{Binding Home.DiagnoseCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                        <Menu Background="Transparent" VerticalAlignment="Center">
                            <MenuItem Header="更多" Foreground="{StaticResource Muted}" FontSize="12.5" FontWeight="Medium"
                                      FontFamily="{StaticResource UiFont}" Padding="11,6" Cursor="Hand">
                                <MenuItem Header="载入合成演示" Command="{Binding LoadDemoCommand}" />
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,22,28,28">
                <StackPanel>
                    <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1" CornerRadius="8"
                            Padding="14,10" Margin="0,0,0,16"
                            Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01"
                                  Stroke="{StaticResource Warn}" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DemoBannerText}" FontSize="12" Foreground="{StaticResource Warn}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>
                    </Border>
                    <ContentControl Content="{Binding SelectedSection.ViewModel}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Status / error bar (polite, never steals focus) -->
            <StackPanel Grid.Row="2">
                <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                        Padding="26,8" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.LiveSetting="Polite">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                </Border>
                <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="0,1,0,0"
                        Padding="26,8" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.LiveSetting="Assertive">
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
