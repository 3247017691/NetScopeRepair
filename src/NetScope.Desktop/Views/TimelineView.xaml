<UserControl x:Class="NetScope.Desktop.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080">
    <StackPanel>
        <!-- Top Summary Card -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DataLabel}" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="重新读取时间线"
                            Command="{Binding DataContext.RefreshTimelineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource QuietButton}" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                    <Border Background="{StaticResource GapBg}" BorderThickness="0"
                            CornerRadius="12" Padding="11,4" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CountsText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CountsText}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource WarnBg}" BorderThickness="0"
                            CornerRadius="12" Padding="11,4"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="有新的采集，点击右侧按钮刷新" FontSize="12" Foreground="{StaticResource Warn}" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                        CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
                    <TextBlock Text="{Binding SessionPath}" Style="{StaticResource Mono}" FontSize="11"
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Modern DataGrid Card -->
        <Border Style="{StaticResource SectionCard}" Padding="0" ClipToBounds="True">
            <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}" MaxHeight="230"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="64" />
                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="144" />
                    <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="96" />
                    <DataGridTemplateColumn Header="状态" Width="104">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BadgeBackground}" BorderThickness="0"
                                        CornerRadius="11" Padding="9,2.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{Binding Tone}" VerticalAlignment="Center" Margin="0,0,5.5,0" />
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding Tone}" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 相邻观察变化 -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="相邻观察变化" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="按接口 GUID / LUID / 地址族匹配" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding ChangeBoundaryText}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           HorizontalAlignment="Left" Margin="0,4,0,8" />
                <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                        CornerRadius="6" Padding="11,8" Margin="0,0,0,10">
                    <TextBlock Text="{Binding ChangeSummaryText}" FontSize="12" Foreground="{StaticResource Ink}"
                               TextWrapping="Wrap" LineHeight="18" />
                </Border>

                <TextBlock Text="没有可展开的相邻差异；上面的计数与原因仍然有效。" Style="{StaticResource Caption}"
                           HorizontalAlignment="Left" Margin="0,0,0,4"
                           Visibility="{Binding HasNoObservationPairs, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding ObservationPairs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding HeaderText}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding IntervalText}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Changes}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineSubtle}"
                                                        BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,5">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="False">
                                                            <Border DockPanel.Dock="Left" Background="{Binding BadgeBackground}"
                                                                    BorderThickness="0" CornerRadius="11" Padding="8,2"
                                                                    Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding KindText}" Foreground="{Binding Tone}"
                                                                           FontSize="10.5" FontWeight="Medium" />
                                                            </Border>
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding FieldText}"
                                                                       FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding IdentityText}"
                                                                       Style="{StaticResource MonoSubtle}" FontSize="10.5"
                                                                       VerticalAlignment="Center" MaxWidth="460"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                        <Grid Margin="0,5,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding BeforeText, StringFormat=之前：{0}}"
                                                                       FontSize="11.5" Foreground="{StaticResource Muted}"
                                                                       TextWrapping="Wrap" Margin="0,0,10,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding AfterText, StringFormat=之后：{0}}"
                                                                       FontSize="11.5" Foreground="{StaticResource Ink}"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Note}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding NotesText}" FontSize="10.5" Foreground="{StaticResource Warn}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Problems & Gaps 2-Column Section -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 读取问题 -->
            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="读取问题" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Problems}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="没有读取问题。">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Problems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 序号缺口与重复 -->
            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="序号缺口与重复" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Gaps}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="序号连续，没有重复事件。">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Gaps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 事件 Payload Terminal Inspector -->
        <Border Style="{StaticResource SectionCard}" Padding="0" ClipToBounds="True">
            <StackPanel>
                <Border Padding="18,14,18,12" Background="{StaticResource Surface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="事件 payload" Style="{StaticResource H2}" />
                        <TextBlock Text="这里显示已保存的最小化事实；凭据与订阅内容不会出现在日志中。" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Left" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <!-- JSON payload viewer (light subtle surface) -->
                <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1" Margin="14,0,14,14" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource HoverSurface}" CornerRadius="8,8,0,0" Padding="12,0" BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,0,0,1">
                            <TextBlock Text="JSON Payload · 只读最小化事实" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        </Border>
                        <ScrollViewer Grid.Row="1" MaxHeight="280" VerticalScrollBarVisibility="Auto" Padding="14,12">
                            <TextBlock Text="{Binding DetailJson}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                       Foreground="{StaticResource Ink}" TextWrapping="Wrap" LineHeight="18" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12"
                   Margin="2,0,0,6" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
