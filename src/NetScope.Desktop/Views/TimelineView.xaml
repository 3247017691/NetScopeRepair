<UserControl x:Class="NetScope.Desktop.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080">
    <StackPanel>
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding DataLabel}" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" Margin="0,4,0,0" MaxWidth="720" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="重新读取时间线"
                            Command="{Binding DataContext.RefreshTimelineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource QuietButton}" VerticalAlignment="Top" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Border Style="{StaticResource Pill}" Background="#F1F4F9" Margin="0,0,8,0">
                        <TextBlock Text="{Binding CountsText}" FontSize="12" />
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="#FFF4E0" Margin="0,0,8,0"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="有新的采集，点击右侧按钮刷新" FontSize="12" Foreground="{StaticResource Warn}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding SessionPath}" Style="{StaticResource Mono}" FontSize="11"
                           Foreground="{StaticResource Muted}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCard}" Padding="10">
            <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}" MaxHeight="360"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="56" />
                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="132" />
                    <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="86" />
                    <DataGridTemplateColumn Header="状态" Width="86">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding Tone}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="读取问题" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Problems}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource Warn}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="没有读取问题。">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Problems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="序号缺口与重复" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Gaps}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource Warn}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="序号连续，没有重复事件。">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Gaps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="事件 payload" Style="{StaticResource H2}" />
                <TextBlock Text="这里显示已保存的最小化事实；凭据与订阅内容不会出现在日志中。" Style="{StaticResource Caption}"
                           Margin="0,4,0,10" />
                <Border Background="#0F172A" CornerRadius="8" Padding="14">
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding DetailJson}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                   Foreground="#D6E2F5" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12"
                   Margin="2,0,0,6" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
