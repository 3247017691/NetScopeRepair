<UserControl x:Class="NetScope.Desktop.Views.CaseReplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080">
    <UserControl.Resources>
        <DataTemplate x:Key="DiagnosisTemplate">
            <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                    CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding Rule}" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Ink}" />
                    <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <!-- 选择与执行 -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="案例重放工作台" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" HorizontalAlignment="Left"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding PackagePath}" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Ink}" />
                    </Border>
                    <Button Grid.Column="2" Content="选择包…" Command="{Binding BrowseCommand}" Style="{StaticResource QuietButton}" />
                    <Button Grid.Column="4" Content="离线重放" Command="{Binding ReplayCommand}" Style="{StaticResource PrimaryButton}" />
                </Grid>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Ink}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 准入与包信息 -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="包准入与版本（输入默认不可信）" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding AdmissionText}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding PackageText}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding RuleSetText}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding FingerprintText}" Style="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- 记录诊断 vs 固定规则重算 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="包内记录诊断（原样）" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding RecordedDiagnoses}" ItemTemplate="{StaticResource DiagnosisTemplate}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="当前固定规则集重算（不代表原版）" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding RecomputedDiagnoses}" ItemTemplate="{StaticResource DiagnosisTemplate}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 差异 -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="记录与重算的差异" Style="{StaticResource H2}" />
                <ItemsControl ItemsSource="{Binding Differences}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Rule}" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Ink}" />
                                    <TextBlock FontSize="12" Foreground="{StaticResource Ink}" Margin="0,3,0,0">
                                        <Run Text="{Binding Disposition}" />
                                        <Run Text="，记录 " />
                                        <Run Text="{Binding Recorded}" />
                                        <Run Text="，重算 " />
                                        <Run Text="{Binding Recomputed}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 逐 snapshot scope -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="逐 snapshot scope 回放（不跨周期混合证据）" Style="{StaticResource H2}" />
                <ItemsControl ItemsSource="{Binding SnapshotScopes}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Sequence}" Style="{StaticResource Mono}" FontSize="11" />
                                    <TextBlock Grid.Column="1" Text="{Binding Snapshot}" Style="{StaticResource Mono}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Counts}" FontSize="11.5" />
                                    <TextBlock Grid.Column="3" Text="{Binding Diagnostics}" FontSize="11.5" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- incident 窗口 -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="Incident 窗口与跨周期证据" Style="{StaticResource H2}" />
                <ItemsControl ItemsSource="{Binding Incidents}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Incident}" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Ink}" />
                                    <TextBlock Text="{Binding Trigger}" FontSize="11.5" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Window}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Scopes}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Missing}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 问题与说明 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="准入/兼容性问题" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Issues}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,2" Foreground="{StaticResource Ink}">
                                    <Run Text="{Binding Severity}" FontWeight="SemiBold" />
                                    <Run Text=" " />
                                    <Run Text="{Binding Code}" />
                                    <Run Text=": " />
                                    <Run Text="{Binding Message}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="旧包说明与缺口" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Notices}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,2" Foreground="{StaticResource Muted}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
