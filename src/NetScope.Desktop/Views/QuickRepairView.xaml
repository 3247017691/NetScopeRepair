<UserControl x:Class="NetScope.Desktop.Views.QuickRepairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:NetScope.Desktop.Controls"
             mc:Ignorable="d" d:DesignWidth="1080">
    <UserControl.Resources>
        <!-- Stage stepper chips: numbered in real execution order; current = accent, completed = check. -->
        <Style x:Key="StageChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="StageChipBadge" TargetType="Border">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{StaticResource SubtleSurface}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StageChipNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StageChipLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="7,0,0,0" />
        </Style>

        <!-- Contextual primary button: one button, content/command follow the stage.
             Review keeps IsEnabled=CanApply: the second-click pending state has IsBusy=false,
             so confirmation stays clickable while a running operation (IsBusy) disables it. -->
        <Style x:Key="StagePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Content" Value="体检本机（只读）" />
            <Setter Property="Command" Value="{Binding RefreshCommand}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="MinWidth" Value="170" />
            <Style.Triggers>
                <!-- Leading busy guard: greys the primary during any running operation (including a
                     Verify-stage handoff/refresh). First so the stage triggers below still win their
                     setters. Two-click pending has IsBusy=false, so confirmation stays clickable. -->
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Stage}" Value="Review">
                    <Setter Property="Content" Value="{Binding ApplyButtonText}" />
                    <Setter Property="Command" Value="{Binding ApplyCommand}" />
                    <Setter Property="IsEnabled" Value="{Binding CanApply}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Stage}" Value="Execute">
                    <Setter Property="Content" Value="正在执行修复" />
                    <Setter Property="Command" Value="{Binding ApplyCommand}" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Stage}" Value="Verify">
                    <Setter Property="Content" Value="重新体检" />
                    <Setter Property="Command" Value="{Binding RefreshCommand}" />
                </DataTrigger>
                <!-- Later trigger wins: an unresolved run turns the Verify primary into the AI handoff
                     entry. No IsEnabled setter, so it inherits the leading busy guard above. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Stage}" Value="Verify" />
                        <Condition Binding="{Binding IsUnresolved}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Content" Value="交给 AI" />
                    <Setter Property="Command" Value="{Binding HandoffCommand}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Quiet toolbar execution buttons: greyed while busy to prevent repeat clicks.
             Pending two-click confirmation is not busy, so it is never caught by this. -->
        <Style x:Key="QuietExecutionButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 1. Stage stepper -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border AutomationProperties.Name="阶段 1：体检">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StageChip}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Inspect">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Badge1">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StageChipBadge}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Stage}" Value="Inspect">
                                        <Setter Property="Background" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Review">
                                        <Setter Property="Background" Value="{StaticResource OkBg}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Execute">
                                        <Setter Property="Background" Value="{StaticResource OkBg}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Verify">
                                        <Setter Property="Background" Value="{StaticResource OkBg}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StageChipNumber}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Stage}" Value="Inspect">
                                            <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Stage}" Value="Review">
                                            <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                            <Setter Property="Text" Value="✓" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Stage}" Value="Execute">
                                            <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                            <Setter Property="Text" Value="✓" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Stage}" Value="Verify">
                                            <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                            <Setter Property="Text" Value="✓" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="体检">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StageChipLabel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Stage}" Value="Inspect">
                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border AutomationProperties.Name="阶段 2：看清问题">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StageChip}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Review">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Badge2">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StageChipBadge}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Stage}" Value="Review">
                                        <Setter Property="Background" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Execute">
                                        <Setter Property="Background" Value="{StaticResource OkBg}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Verify">
                                        <Setter Property="Background" Value="{StaticResource OkBg}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StageChipNumber}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Stage}" Value="Review">
                                            <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Stage}" Value="Execute">
                                            <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                            <Setter Property="Text" Value="✓" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Stage}" Value="Verify">
                                            <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                            <Setter Property="Text" Value="✓" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="看清问题">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StageChipLabel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Stage}" Value="Review">
                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border AutomationProperties.Name="阶段 3：执行">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StageChip}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Execute">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Badge3">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StageChipBadge}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Stage}" Value="Execute">
                                        <Setter Property="Background" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Verify">
                                        <Setter Property="Background" Value="{StaticResource OkBg}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="3">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StageChipNumber}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Stage}" Value="Execute">
                                            <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Stage}" Value="Verify">
                                            <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                            <Setter Property="Text" Value="✓" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="执行">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StageChipLabel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Stage}" Value="Execute">
                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border AutomationProperties.Name="阶段 4：自检">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StageChip}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="Verify">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Badge4">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StageChipBadge}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Stage}" Value="Verify">
                                        <Setter Property="Background" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StageChipNumber}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Stage}" Value="Verify">
                                            <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="自检">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StageChipLabel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Stage}" Value="Verify">
                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 2. Instrument hero: unmeasured renders all-Unknown with — readouts, never implied health -->
        <controls:NetworkPathInstrument Model="{Binding NetworkPath}" Margin="0,0,0,14" />

        <!-- 3. Verdict -->
        <TextBlock x:Name="VerdictBlock" Text="{Binding VerdictText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14" />

        <!-- 4. Problem-fix paired list -->
        <StackPanel x:Name="PairingPanel" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
            <ItemsControl ItemsSource="{Binding RepairItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,13,0" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProblemText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                        <TextBlock Text="{Binding CodeRef}" Style="{StaticResource MonoSubtle}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding HasFinding, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding FixText}" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding BeforeAfterText}" Margin="0,5,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MonoSubtle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BeforeAfterText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RiskBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                        </Border>
                                        <TextBlock Text="改动记入 journal，可一键回滚" FontSize="11" Foreground="{StaticResource Muted}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="本次体检未发现可修复问题。">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RepairItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- 5. Contextual primary button + quiet toolbar -->
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource StagePrimaryButton}" VerticalAlignment="Center" />
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="开代理" Command="{Binding ProxyOnCommand}" Style="{StaticResource QuietExecutionButton}" Margin="0,0,8,0" />
                <Button Content="关代理" Command="{Binding ProxyOffCommand}" Style="{StaticResource QuietExecutionButton}" Margin="0,0,8,0" />
                <Button Content="{Binding RestoreButtonText}" Command="{Binding RestoreCommand}" Style="{StaticResource QuietExecutionButton}" Margin="0,0,8,0" />
                <Button Content="交给 AI" Command="{Binding HandoffCommand}" Style="{StaticResource QuietExecutionButton}" Margin="0,0,8,0" />
                <Button Content="还是没好" Command="{Binding MarkUnresolvedCommand}" Style="{StaticResource QuietButton}" Margin="0,0,12,0" />
                <CheckBox Content="高风险模式" IsChecked="{Binding Deep, Mode=TwoWay}" VerticalAlignment="Center"
                          Foreground="{StaticResource Muted}" FontSize="11.5" />
            </WrapPanel>
        </Grid>
        <TextBlock Text="高风险模式会额外列出「移除幽灵网卡」「重置旧接口静态 DNS」，默认不勾选。接口度量 / WinHTTP / 机器级变量需要管理员权限。"
                   FontSize="11" Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,14" />

        <!-- 6. Live execution status band: immediate feedback the moment a command runs -->
        <Border Style="{StaticResource SectionCard}" Padding="14,12"
                AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="修复执行状态">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center">
                        <controls:Spinner IsActive="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                          Stroke="{StaticResource Accent}" Thickness="2" Width="18" Height="18" />
                        <TextBlock FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="●" />
                                    <Setter Property="Foreground" Value="{StaticResource Gap}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RunState}" Value="Running">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RunState}" Value="Success">
                                            <Setter Property="Text" Value="✓" />
                                            <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RunState}" Value="Failed">
                                            <Setter Property="Text" Value="✕" />
                                            <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPhaseText}" FontSize="12.5" FontWeight="Medium"
                                   Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"
                                   Text="{Binding RunStateText, StringFormat=状态：{0}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Mono}" FontSize="12"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <ProgressBar Style="{StaticResource LinearProgressBar}" Margin="0,10,0,0"
                             Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue, Mode=OneWay}"
                             Visibility="{Binding HasDeterminateProgress, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- Live execution steps -->
        <Border Style="{StaticResource SectionCard}" Visibility="{Binding HasRun, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="执行步骤" Style="{StaticResource H2}" />
                <Border Height="1" Background="{StaticResource LineSubtle}" Margin="0,8,0,10" />
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,9" Margin="0,0,0,8" Loaded="OnStepRowLoaded">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <controls:Spinner IsActive="{Binding IsRunning}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                                          Stroke="{StaticResource Accent}" Thickness="2" Width="16" Height="16" />
                                        <Ellipse Width="12" Height="12" Stroke="{StaticResource Line}" StrokeThickness="1.5" Fill="Transparent"
                                                 Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Glyph}" Foreground="{Binding Tone}" FontSize="13" FontWeight="SemiBold"
                                                   Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ResultText}" Style="{StaticResource MonoSubtle}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,2,0,0">
                                        <Border Background="{Binding ToneBg}" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding Tone}" />
                                        </Border>
                                        <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource MonoSubtle}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Real-time log: expanded during Execute, collapsed otherwise -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <Expander Background="Transparent" BorderThickness="0" Padding="0">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Setter Property="IsExpanded" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Stage}" Value="Execute">
                                    <Setter Property="IsExpanded" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="实时日志" Style="{StaticResource H2}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LogCount, StringFormat=（{0} 行）}" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <controls:Spinner IsActive="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                              Stroke="{StaticResource Accent}" Thickness="1.6" Width="13" Height="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Expander.Header>
                    <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="2">
                        <Grid>
                            <ScrollViewer x:Name="LogScroll" MaxHeight="280" VerticalScrollBarVisibility="Auto" Padding="10,8">
                                <ItemsControl ItemsSource="{Binding LogLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,3" Loaded="OnLogLineLoaded">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                           Foreground="{StaticResource SubtleText}" VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                           Foreground="{Binding Tone}" TextWrapping="Wrap" LineHeight="17" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="执行修复或体检时，这里会逐行实时输出。" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                       Foreground="{StaticResource SubtleText}" Margin="12,10" VerticalAlignment="Top"
                                       Visibility="{Binding HasLog, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                    </Border>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Observation context: what was measured, elevation limits, journal backup -->
        <Border Style="{StaticResource SubtleCard}" Margin="0,0,0,12" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding SummaryText}" FontSize="12.5" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ElevationText}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock Text="{Binding JournalText}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- 7. Boundary note -->
        <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <TextBlock FontSize="11.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                       Text="边界：本页不禁用物理网卡、不删除路由表条目、不动 VMware/系统虚拟适配器；TUN 修复只动 TUN 网卡（ActiveStore，重开 TUN/重启后可能重置）。全部改动记入回滚备份，可一键还原。" />
        </Border>
    </StackPanel>
</UserControl>
