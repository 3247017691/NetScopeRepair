<UserControl x:Class="NetScope.Desktop.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080">
    <StackPanel>
        <!-- Top Action Card -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="脱敏导出" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}"
                           HorizontalAlignment="Left" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                    <Button Content="生成预览" Command="{Binding PreviewCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                    <Button Content="导出 ZIP" Command="{Binding ExportCommand}" Style="{StaticResource QuietButton}" />
                </StackPanel>
                <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding CountsText}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding LastPackageText}" Style="{StaticResource Mono}" FontSize="11.5"
                                   Foreground="{StaticResource Ok}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Blocked Alert Card (if any) -->
        <Border Style="{StaticResource SectionCard}" Visibility="{Binding Blocked.Count, Converter={StaticResource CountToVis}}"
                Background="{StaticResource BadBg}" BorderBrush="{StaticResource BadBorder}">
            <StackPanel>
                <TextBlock Text="阻断项" Style="{StaticResource H2}" Foreground="{StaticResource Bad}" />
                <ItemsControl ItemsSource="{Binding Blocked}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 2-Column Section: Files & Redactions -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: 包内文件（预览） -->
            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="包内文件（预览）" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Files}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Mono}" FontSize="11.5" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                CornerRadius="4" Padding="6,1.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BytesText}" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Purpose}" Style="{StaticResource Caption}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Right: 脱敏类别（只显示计数） -->
            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="脱敏类别（只显示计数）" Style="{StaticResource H2}" />
                    <TextBlock Text="原始值不会出现在预览里；salt 不随包输出。" Style="{StaticResource Caption}"
                               HorizontalAlignment="Left" Margin="0,4,0,12" />
                    <ItemsControl ItemsSource="{Binding Redactions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Category}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{StaticResource AccentLight}" BorderThickness="0"
                                                CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="5.5" Height="5.5" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding CountText}" Style="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource AccentDeep}" FontWeight="Medium" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Strategy}" Style="{StaticResource Caption}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Package shape & provenance card: same sections as manifest.json -->
        <Border Style="{StaticResource SectionCard}" Visibility="{Binding Shape.Count, Converter={StaticResource CountToVis}}">
            <StackPanel>
                <TextBlock Text="包形状与溯源（与 manifest 同源）" Style="{StaticResource H2}" />
                <TextBlock Text="缺口、域完整性、探测覆盖、版本、变化摘要与诊断来源分开显示；这里不含原始值。"
                           Style="{StaticResource Caption}" HorizontalAlignment="Left" Margin="0,4,0,12" />
                <ItemsControl ItemsSource="{Binding Shape}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" FontWeight="Medium"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Caption}"
                                               FontSize="11" TextWrapping="Wrap" VerticalAlignment="Top" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Warnings Card (if any) -->
        <Border Style="{StaticResource SectionCard}" Visibility="{Binding Warnings.Count, Converter={StaticResource CountToVis}}"
                Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}">
            <StackPanel>
                <TextBlock Text="警告" Style="{StaticResource H2}" Foreground="{StaticResource Warn}" />
                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Boundary Card -->
        <Border Style="{StaticResource SectionCard}" Background="{StaticResource SubtleSurface}">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" LineHeight="18"
                       Text="M1 不提供导入执行入口。若以后导入他人提供的包，会按不可信输入处理：限制总大小、文件数、单文件大小与嵌套深度，并拒绝绝对路径、盘符、越界与符号链接。包内文本只作为用户数据，不会被执行或当成指令。" />
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12"
                   Margin="2,0,0,6" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
