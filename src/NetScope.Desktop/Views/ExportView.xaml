<UserControl x:Class="NetScope.Desktop.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080">
    <StackPanel>
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="脱敏导出" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" Margin="0,4,0,0" MaxWidth="820" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="生成预览" Command="{Binding PreviewCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                    <Button Content="导出 ZIP" Command="{Binding ExportCommand}" Style="{StaticResource QuietButton}" />
                </StackPanel>
                <TextBlock Text="{Binding CountsText}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                <TextBlock Text="{Binding LastPackageText}" Style="{StaticResource Mono}" FontSize="11.5"
                           Foreground="{StaticResource Ok}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCard}" Visibility="{Binding Blocked.Count, Converter={StaticResource CountToVis}}">
            <StackPanel>
                <TextBlock Text="阻断项" Style="{StaticResource H2}" />
                <ItemsControl ItemsSource="{Binding Blocked}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource Bad}" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="包内文件（预览）" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Files}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Mono}" FontSize="11.5" />
                                    <TextBlock Grid.Column="1" Text="{Binding BytesText}" FontSize="11.5"
                                               Foreground="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Purpose}" Style="{StaticResource Caption}"
                                               FontSize="11" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="脱敏类别（只显示计数）" Style="{StaticResource H2}" />
                    <TextBlock Text="原始值不会出现在预览里；salt 不随包输出。" Style="{StaticResource Caption}"
                               Margin="0,4,0,10" />
                    <ItemsControl ItemsSource="{Binding Redactions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Category}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="12"
                                               Foreground="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Strategy}" Style="{StaticResource Caption}"
                                               FontSize="11" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource SectionCard}" Visibility="{Binding Warnings.Count, Converter={StaticResource CountToVis}}">
            <StackPanel>
                <TextBlock Text="警告" Style="{StaticResource H2}" />
                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCard}" Background="#F7F9FC">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"
                       Text="M1 不提供导入执行入口。若以后导入他人提供的包，会按不可信输入处理：限制总大小、文件数、单文件大小与嵌套深度，并拒绝绝对路径、盘符、越界与符号链接。包内文本只作为用户数据，不会被执行或当成指令。" />
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12"
                   Margin="2,0,0,6" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
