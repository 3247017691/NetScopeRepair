<UserControl x:Class="NetScope.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080">
    <StackPanel>

        <Border Style="{StaticResource SectionCard}" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{Binding HealthTone}" CornerRadius="10,0,0,10" />
                <StackPanel Grid.Column="1" Margin="22,20,22,20">
                    <TextBlock Text="{Binding HealthTitle}" FontSize="24" FontWeight="SemiBold"
                               Foreground="{Binding HealthTone}" />
                    <TextBlock Text="{Binding HealthDetail}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               MaxWidth="820" HorizontalAlignment="Left" FontSize="12.5" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Border Style="{StaticResource Pill}" Background="#F1F4F9" Margin="0,0,8,0">
                            <TextBlock Text="{Binding StateText, StringFormat=会话：{0}}" FontSize="12" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="#F1F4F9" Margin="0,0,8,0">
                            <TextBlock Text="{Binding SnapshotText}" FontSize="12" />
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="#F1F4F9">
                            <TextBlock Text="{Binding EventText}" FontSize="12" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="数据域完整性" Style="{StaticResource H2}" />
                    <TextBlock Text="任何一个域没有读到，都会显示为采集中断，而不是空结果。" Style="{StaticResource Caption}"
                               Margin="0,4,0,14" />
                    <ItemsControl ItemsSource="{Binding Domains}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding Tone}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding Tone}"
                                               FontSize="12.5" />
                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="当前会话" Style="{StaticResource H2}" />
                    <TextBlock Text="关闭窗口只隐藏到托盘；显式退出才停止记录。" Style="{StaticResource Caption}"
                               Margin="0,4,0,14" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="日志写入" Foreground="{StaticResource Muted}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding PersistenceText}" FontSize="12" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="最近一轮" Foreground="{StaticResource Muted}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding LastCycleText}" FontSize="12" TextWrapping="Wrap" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="探测目标" Foreground="{StaticResource Muted}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding TargetText}" FontSize="12" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="会话文件" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,4" />
                    <TextBlock Text="{Binding SessionPathText}" Style="{StaticResource Mono}" FontSize="11"
                               Foreground="{StaticResource Muted}" />
                    <Button Content="立即采集一次" Command="{Binding CollectCommand}"
                            Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="最近诊断" Style="{StaticResource H2}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LastCycleText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding RecentDiagnoses}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FAFBFD" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{Binding Tone}" CornerRadius="999" Padding="8,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding LevelText}" Foreground="White" FontSize="11" />
                                        </Border>
                                        <TextBlock Text="{Binding RuleId}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding RuleVersion, StringFormat=v{0}}" Style="{StaticResource Caption}"
                                                   Margin="6,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12.5" />
                                    <TextBlock Text="{Binding NextStep, StringFormat=建议下一步：{0}}" Style="{StaticResource Caption}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="没有结论不等于一切正常；请查看时间线里的观察缺口与采集错误。"
                           Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCard}" Background="#F7F9FC">
            <StackPanel>
                <TextBlock Text="边界" Style="{StaticResource H2}" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"
                           Text="“当前样本正常”只说明本次采集的数据域完整、没有产生异常结论，不代表全网正常或浏览器已恢复。M1 没有任何修改系统网络设置的入口；修复能力属于 M3，并且必须先有证据、预览与用户授权。" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12"
                   Margin="2,0,0,6" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</UserControl>
