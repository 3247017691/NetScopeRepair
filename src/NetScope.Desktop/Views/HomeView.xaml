<UserControl x:Class="NetScope.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080">
    <StackPanel>
        <!-- Top Status Overview Hero Card -->
        <Border Style="{StaticResource SectionCard}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Status Indicator & Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Status Ring Indicator -->
                        <Border Width="24" Height="24" CornerRadius="12" Background="{Binding HealthTone}" Margin="0,0,12,0" Opacity="0.15" />
                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding HealthTone}" Margin="-30,0,18,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HealthTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{Binding HealthTone}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding HealthDetail}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               HorizontalAlignment="Left" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" />
                </StackPanel>

                <!-- Right: 3 KPI Micro-Blocks -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- KPI 1: 采集健康 -->
                    <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="6" Padding="14,10" MinWidth="128" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="采集健康（本机）" FontSize="11" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{Binding CollectionHealthTitle}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{Binding CollectionHealthTone}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: 网络验证 -->
                    <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="6" Padding="14,10" MinWidth="150" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="网络验证（外部探测）" FontSize="11" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{Binding VerificationTitle}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{Binding VerificationTone}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: 最近诊断时间 -->
                    <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="6" Padding="14,10" MinWidth="150">
                        <StackPanel>
                            <TextBlock Text="最近诊断时间" FontSize="11" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{Binding DiagnosisTimeText}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Middle 2-Column Equal-Height Section -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: 采集健康 -->
            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="采集健康（本机数据域）" Style="{StaticResource H2}" />
                    <TextBlock Text="任何一个域没有读到，都会显示为采集中断，而不是空结果。只描述本机采集，不代表网络连通性。"
                               Style="{StaticResource Caption}" HorizontalAlignment="Left" Margin="0,4,0,14" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Domains}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Mono}" FontWeight="SemiBold"
                                                   FontSize="12" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{Binding BadgeBackground}" BorderThickness="0"
                                                CornerRadius="11" Padding="8,2.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{Binding Tone}" VerticalAlignment="Center" Margin="0,0,5.5,0" />
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding Tone}" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Right: 当前会话 -->
            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="当前会话" Style="{StaticResource H2}" />
                    <TextBlock Text="关闭窗口只隐藏到托盘；显式退出才停止记录。" Style="{StaticResource Caption}"
                               HorizontalAlignment="Left" Margin="0,4,0,14" />

                    <!-- Key-Value Pairs -->
                    <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="观察状态" Foreground="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="最近快照" Foreground="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding SnapshotText}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="累计事件" Foreground="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding EventText}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="日志写入" Foreground="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding PersistenceText}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="最近一轮" Foreground="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding LastCycleText}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="探测目标" Foreground="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding TargetText}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Session File in Code Box -->
                    <TextBlock Text="会话文件" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,4" />
                    <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="6" Padding="10,7">
                        <TextBlock Text="{Binding SessionPathText}" Style="{StaticResource Mono}" FontSize="11"
                                   Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Manual Trigger Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="修复网络" Command="{Binding OpenRepairCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                        <Button Content="立即采集一次" Command="{Binding CollectCommand}"
                                Style="{StaticResource QuietButton}" />
                    </StackPanel>
                    <TextBlock Text="{Binding RepairHintText}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Left" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Network verification: what the last explicit probe actually showed -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="网络验证（外部探测）" Style="{StaticResource H2}" />
                </DockPanel>
                <TextBlock Text="三条路径只有在同目标、同方法、同地址族、同观察窗口内才合并比较；缺失、Unsupported 与取消都不是通过。"
                           Style="{StaticResource Caption}" HorizontalAlignment="Left" Margin="0,4,0,10" TextWrapping="Wrap" />

                <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                        CornerRadius="6" Padding="12,9" Margin="0,0,0,8">
                    <TextBlock Text="{Binding VerificationPathsText}" FontSize="12" Foreground="{StaticResource Ink}"
                               TextWrapping="Wrap" LineHeight="18" />
                </Border>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <Ellipse Width="7" Height="7" Fill="{Binding VerificationTone}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="未配置探测目标时仍会运行本地规则诊断；0 条探测结果显示为“尚未进行外部验证”，不会转绿。"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="820" />
                </StackPanel>

                <TextBlock Text="{Binding VerificationDetail}" FontSize="12" Foreground="{StaticResource Ink}"
                           TextWrapping="Wrap" LineHeight="19" />

                <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                    <TextBlock Text="{Binding VerificationBoundaryText}" FontSize="12" Foreground="{StaticResource Warn}"
                               TextWrapping="Wrap" LineHeight="18" />
                </Border>

                <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                    <TextBlock Text="{Binding TargetText}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Bottom: 最近诊断 -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="最近诊断" Style="{StaticResource H2}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DiagnosisTimeText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding DiagnosisDetailText}" Style="{StaticResource Caption}" HorizontalAlignment="Left"
                           Margin="0,4,0,0" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding RecentDiagnoses}" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- shadcn Alert / Card style -->
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Magpie Soft Capsule Badge -->
                                            <Border Background="{Binding BadgeBackground}" BorderThickness="0"
                                                    CornerRadius="11" Padding="9,3" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding Tone}" VerticalAlignment="Center" Margin="0,0,5.5,0" />
                                                    <TextBlock Text="{Binding LevelText}" Foreground="{Binding Tone}" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding RuleId}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RuleVersion, StringFormat=v{0}}" Style="{StaticResource Caption}"
                                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Summary}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Ink}" LineHeight="20" />
                                    <!-- Next Step Highlight Banner -->
                                    <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                            CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding NextStep, StringFormat=建议下一步：{0}}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="没有结论不等于一切正常；请查看时间线里的观察缺口与采集错误。"
                           Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Boundary Note Card -->
        <Border Style="{StaticResource SectionCard}" Background="{StaticResource SubtleSurface}">
            <StackPanel>
                <TextBlock Text="边界" Style="{StaticResource H2}" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0" LineHeight="18"
                           Text="采集健康只说明本机数据域是否读到；网络验证只说明已启用目标的探测结果；最近诊断时间只说明规则何时运行。三者互不替代：0 条探测显示“尚未进行外部验证”，空诊断不会转绿，也不代表全网正常或浏览器已恢复。本页没有任何修改系统网络设置的入口；修复在「修复」页进行，必须先体检、勾选并二次确认。" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12"
                   Margin="2,0,0,6" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</UserControl>
