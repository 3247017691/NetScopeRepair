<UserControl x:Class="NetScope.Desktop.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080">
    <StackPanel>
        <Border Style="{StaticResource SectionCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="多客户端统一状态" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}" Margin="0,4,0,0" MaxWidth="760" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="刷新状态" Command="{Binding RefreshCommand}"
                        Style="{StaticResource QuietButton}" VerticalAlignment="Top" />
            </DockPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource H2}" />
                                <Border Style="{StaticResource Pill}" Background="#F1F4F9" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding RunningText}" FontSize="11" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Background="#F1F4F9" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding TunText}" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="端点" Foreground="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding EndpointsText}" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="0" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="配置来源" Foreground="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding ProvenanceText}" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="版本" Foreground="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="缺口" Foreground="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding GapsText}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource Warn}" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="说明" Foreground="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding NotesText}" FontSize="12" TextWrapping="Wrap" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFBFD" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                CornerRadius="8" Padding="11" Margin="0,0,0,6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ProvenanceText}" FontWeight="SemiBold" FontSize="11.5" />
                                                    <TextBlock Text="{Binding ValidityText}" Style="{StaticResource Caption}"
                                                               Margin="10,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding FactsText}" Style="{StaticResource Mono}"
                                                           FontSize="11" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="应用代理依赖解释" Style="{StaticResource H2}" />
                <TextBlock Text="说明每个应用可能从哪一层读取代理；未知继承会显式标出，不做猜测。" Style="{StaticResource Caption}"
                           Margin="0,4,0,10" />
                <ItemsControl ItemsSource="{Binding Dependencies}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FAFBFD" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="8" Padding="13" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" />
                                    <ItemsControl ItemsSource="{Binding Layers}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" />
                                                    <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="11.5"
                                                               Foreground="{StaticResource Muted}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11.5"
                                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding GapsText, StringFormat=未知/缺口：{0}}" Style="{StaticResource Caption}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding Boundary}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                               Foreground="{StaticResource Warn}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12"
                   Margin="2,0,0,6" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
