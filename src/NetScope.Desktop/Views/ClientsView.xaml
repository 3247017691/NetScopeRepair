<UserControl x:Class="NetScope.Desktop.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080">
    <StackPanel>
        <!-- Top Summary Card -->
        <Border Style="{StaticResource SectionCard}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="多客户端统一状态" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Notice}" Style="{StaticResource Caption}"
                               HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="刷新状态" Command="{Binding RefreshCommand}"
                        Style="{StaticResource QuietButton}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Magpie Provider Cards: Clients List -->
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <!-- Header: Client Display Name + Status Pills -->
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                    <!-- Running Status Pill (Magpie Tinted Capsule) -->
                                    <Border Background="{Binding RunningBg}" BorderThickness="0"
                                            CornerRadius="11" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{Binding RunningTone}" VerticalAlignment="Center" Margin="0,0,5.5,0" />
                                            <TextBlock Text="{Binding RunningText}" FontSize="11.5" Foreground="{Binding RunningTone}" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <!-- TUN Status Pill (Magpie Tinted Capsule) -->
                                    <Border Background="{Binding TunBg}" BorderThickness="0"
                                            CornerRadius="11" Padding="9,3" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{Binding TunTone}" VerticalAlignment="Center" Margin="0,0,5.5,0" />
                                            <TextBlock Text="{Binding TunText}" FontSize="11.5" Foreground="{Binding TunTone}" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <!-- Middle: Structured 2x2 / Key-Value Grid -->
                            <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="6" Padding="14,10" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="端点" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EndpointsText}" Style="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" Margin="0,3" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="配置来源" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProvenanceText}" FontSize="12" TextWrapping="Wrap" Margin="0,3" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="版本" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VersionText}" FontSize="12" Margin="0,3" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="缺口" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GapsText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource Warn}" FontWeight="Medium" Margin="0,3" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="说明" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding NotesText}" FontSize="12" TextWrapping="Wrap" Margin="0,3" />
                                </Grid>
                            </Border>

                            <!-- Bottom: Config Evidence Blocks -->
                            <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding ProvenanceText}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Ink}" />
                                                    <Border DockPanel.Dock="Left" Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                                            CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding ValidityText}" FontSize="11" Foreground="{StaticResource Muted}" />
                                                    </Border>
                                                </DockPanel>
                                                <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                                        CornerRadius="4" Padding="8,6" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding FactsText}" Style="{StaticResource Mono}"
                                                               FontSize="11" LineHeight="17" TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- App Proxy Dependency Explanation Card -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="应用代理依赖解释" Style="{StaticResource H2}" />
                <TextBlock Text="说明每个应用可能从哪一层读取代理；未知继承会显式标出，不做猜测。" Style="{StaticResource Caption}"
                           HorizontalAlignment="Left" Margin="0,4,0,12" />
                <ItemsControl ItemsSource="{Binding Dependencies}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                    CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource Ink}" />
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,8" />

                                    <!-- Table Rows for Dependency Layers -->
                                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                                        <ItemsControl ItemsSource="{Binding Layers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium" FontSize="11.5" Foreground="{StaticResource Ink}" />
                                                        <Border Grid.Column="1" Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                                                                CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding State}" FontSize="11" Foreground="{StaticResource Muted}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11.5"
                                                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="8,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <TextBlock Text="{Binding GapsText, StringFormat=未知/缺口：{0}}" Style="{StaticResource Caption}"
                                               Margin="0,8,0,0" />
                                    <!-- Amber Boundary Callout -->
                                    <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,6" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Boundary}" FontSize="11.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12"
                   Margin="2,0,0,6" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
