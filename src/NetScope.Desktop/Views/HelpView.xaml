<UserControl x:Class="NetScope.Desktop.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080">
    <StackPanel>
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="离线帮助" Style="{StaticResource H2}" />
                <TextBlock Text="没有网络、没有 API Key 也能查看本页。M1 不会上传日志，也不会请求 DeepSeek。"
                           Style="{StaticResource Caption}" Margin="0,4,0,0" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="数据目录" Foreground="{StaticResource Muted}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding DataRoot}" Style="{StaticResource Mono}" FontSize="11" />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="会话文件" Foreground="{StaticResource Muted}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding SessionPath}" Style="{StaticResource Mono}" FontSize="11" />
                </Grid>
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="12.5" Margin="0,8,0,0"
                                       Foreground="{StaticResource Ink}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
