<UserControl x:Class="NetScope.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080">
    <StackPanel>
        <!-- Main Settings Group Card -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="观察与探测设置" Style="{StaticResource H2}" />
                <TextBlock Text="这里只保存本应用自己的偏好与目标档案，不会应用到系统网络配置，也不会自动开始外部探测。"
                           Style="{StaticResource Caption}" HorizontalAlignment="Left" Margin="0,4,0,8" />
                <Border Background="{StaticResource SubtleSurface}" BorderBrush="{StaticResource LineSubtle}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                    <TextBlock Text="{Binding TargetProfileCaption}" FontSize="12" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" LineHeight="18" />
                </Border>

                <!-- Setting Row 1: 快照间隔 -->
                <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="本机快照间隔（秒）" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="1—600；默认 10 秒。只读取本机配置，不联网。" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Setting Row 2: 目标档案 ID -->
                <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="目标档案 ID" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="用于在结论与探测里区分同一目标；只在本机使用，不代表真实业务身份。"
                                       Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding TargetId, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Setting Row 3: 探测目标 URL -->
                <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="探测目标 URL" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="留空则禁用外部验证。保存或打开设置不会请求该地址；只有首页“立即诊断”才会发起。"
                                       Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding TargetEndpoint, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Setting Row 4: 请求方法（固定） -->
                <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="请求方法" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="三条路径必须使用同一方法；本轮不提供会改变目标状态的方法。"
                                       Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding MethodText}" Style="{StaticResource Mono}" FontSize="12"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Setting Row 3: 期望 HTTP 状态 -->
                <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="期望 HTTP 状态" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="用于区分“按预期可达”与“可达但响应不同”。" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding ExpectedStatus, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Setting Row 4: 显式代理端点 -->
                <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="显式代理端点" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="例如 http://127.0.0.1:7890；不能含账号、密码、路径或查询。留空则显式路径如实报告未配置。"
                                       Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding ExplicitProxy, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Setting Row 5: 地址族 -->
                <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="地址族" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="{Binding FamilyNotice}" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding FamilyIndex}" VerticalAlignment="Center">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="IPv4" />
                            <ComboBoxItem Content="IPv6" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Save Action Button -->
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="保存设置" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tray & Close Behavior Card -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="托盘与退出" Style="{StaticResource H2}" />
                <TextBlock Text="控制点击右上角关闭按钮时的默认动作；托盘右键菜单始终可显式退出并停止观察。"
                           Style="{StaticResource Caption}" HorizontalAlignment="Left" Margin="0,4,0,14" />

                <Border BorderBrush="{StaticResource LineSubtle}" BorderThickness="0" Padding="0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="关闭窗口时的行为" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                            <TextBlock Text="首次关闭默认弹窗询问；如果勾选过“记住我的选择”，可随时在此切换或恢复每次询问。"
                                       Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding CloseBehaviorIndex}" VerticalAlignment="Center">
                            <ComboBoxItem Content="每次关闭窗口时询问（默认）" />
                            <ComboBoxItem Content="隐藏到托盘继续观察" />
                            <ComboBoxItem Content="直接退出并停止采集" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Boundary Card -->
        <Border Style="{StaticResource SectionCard}" Background="{StaticResource SubtleSurface}">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" LineHeight="18"
                       Text="边界：保存设置不会修改路由、接口度量、DNS、代理环境变量、TUN 或任何客户端配置；也没有管理员提权入口。" />
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12"
                   Margin="2,0,0,6" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
