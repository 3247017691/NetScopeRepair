<UserControl x:Class="NetScope.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080">
    <StackPanel>
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="观察与探测设置" Style="{StaticResource H2}" />
                <TextBlock Text="这里只保存本应用自己的偏好，不会应用到系统网络配置，也不会自动开始外部探测。"
                           Style="{StaticResource Caption}" Margin="0,4,0,14" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="本机快照间隔（秒）" VerticalAlignment="Center" FontSize="12" />
                    <TextBox Grid.Column="1" Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" BorderBrush="{StaticResource Line}" BorderThickness="1" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="1—600；默认 10 秒。只读取本机配置，不联网。"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="探测目标 URL" VerticalAlignment="Center" FontSize="12" />
                    <TextBox Grid.Column="1" Text="{Binding TargetEndpoint, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" BorderBrush="{StaticResource Line}" BorderThickness="1" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="留空则禁用探测。M1 只在你点击“立即诊断”后请求该地址。"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0"
                               TextWrapping="Wrap" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="期望 HTTP 状态" VerticalAlignment="Center" FontSize="12" />
                    <TextBox Grid.Column="1" Text="{Binding ExpectedStatus, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" BorderBrush="{StaticResource Line}" BorderThickness="1" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="用于区分“按预期可达”与“可达但响应不同”。"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="显式代理端点" VerticalAlignment="Center" FontSize="12" />
                    <TextBox Grid.Column="1" Text="{Binding ExplicitProxy, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" BorderBrush="{StaticResource Line}" BorderThickness="1" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="例如 http://127.0.0.1:7890；不能含账号、密码、路径或查询。留空则显式路径如实报告未配置。"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0"
                               TextWrapping="Wrap" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="地址族" VerticalAlignment="Center" FontSize="12" />
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding FamilyIndex}" Padding="8,6" FontSize="12"
                              BorderBrush="{StaticResource Line}">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="IPv4" />
                        <ComboBoxItem Content="IPv6" />
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="{Binding FamilyNotice}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="保存设置" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="托盘与退出" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding HideOnCloseText, StringFormat=当前行为：{0}}" Style="{StaticResource Caption}"
                           Margin="0,6,0,0" />
                <TextBlock Text="首次关闭窗口时会询问“隐藏到托盘继续观察”或“退出并停止采集”，可以记住选择。"
                           Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCard}" Background="#F7F9FC">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"
                       Text="边界：保存设置不会修改路由、接口度量、DNS、代理环境变量、TUN 或任何客户端配置；也没有管理员提权入口。" />
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Muted}" FontSize="12"
                   Margin="2,0,0,6" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
