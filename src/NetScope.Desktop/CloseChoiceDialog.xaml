<Window x:Class="NetScope.Desktop.CloseChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭窗口" Width="490" SizeToContent="Height" ResizeMode="NoResize"
        Icon="pack://application:,,,/Resources/netscope.ico"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}" ShowInTaskbar="False">
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="14" Padding="24">
        <StackPanel>
            <TextBlock Text="隐藏到托盘，还是退出？" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
            <TextBlock Margin="0,8,0,16" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}" LineHeight="19"
                       Text="隐藏后当前观察继续在托盘中运行；显式退出会停止采集并尝试把可写日志刷盘。退出期间的故障不会留下前后窗记录（M2 才实现）。" />
            <CheckBox x:Name="RememberCheck" Content="记住我的选择（可在设置中查看）" FontSize="12" Margin="0,0,0,20" />
            <Border Height="1" Background="{StaticResource LineSubtle}" Margin="0,0,0,16" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="隐藏到托盘" Click="OnHide" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                <Button Content="退出并停止采集" Click="OnExit" Style="{StaticResource QuietButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
