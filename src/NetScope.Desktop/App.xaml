<Application x:Class="NetScope.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NetScope.Desktop.ViewModels"
             xmlns:views="clr-namespace:NetScope.Desktop.Views"
             xmlns:conv="clr-namespace:NetScope.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />

            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TimelineViewModel}">
                <views:TimelineView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiagnosesViewModel}">
                <views:DiagnosesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RepairViewModel}">
                <views:RepairView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QuickRepairViewModel}">
                <views:QuickRepairView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CaseReplayViewModel}">
                <views:CaseReplayView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ClientsViewModel}">
                <views:ClientsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExportViewModel}">
                <views:ExportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HelpViewModel}">
                <views:HelpView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

